# 服务监听
HOST=0.0.0.0
PORT=8765

# 管理后台口令；生产首次启动会自动生成随机值
ADMIN_AUTH_TOKEN=change-me-random-admin-token

# SQLite 是唯一运行时存储；相对路径以配置根目录为基准
SQLITE_FILE=./ccop.db

# 仅用于旧安装升级；目标 SQLite 已初始化后不会读取迁移源
# MIGRATE_FROM_JSON=./runtime_models.json

# 上游请求与诊断截断
REQUEST_TIMEOUT_MS=300000
REQUEST_STREAM_IDLE_TIMEOUT_MS=120000
MAX_REQUEST_BODY_CHARS=4000
MAX_RESPONSE_BODY_CHARS=4000

# 日志
LOG_LEVEL=info
LOG_FORMAT=text
LOG_DETAILED=false
LOG_FILE=./logs/app.log
LOG_ROTATION=daily
LOG_MAX_FILES=30
LOG_MAX_SIZE=52428800

# Key 错误自动禁用；Provider 可在管理端单独关闭
KEY_AUTO_DISABLE=true
KEY_MAX_ERRORS=5

# HTTP 连接池与响应压缩协商
MAX_SOCKETS=100
KEEP_ALIVE_TIMEOUT=60000
FORCE_IDENTITY_ACCEPT_ENCODING=false

# 入站限流
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# SQLite WAL 支持多个 Worker
CLUSTER_WORKERS=1

# 可选脱敏告警；Webhook URL 不会在管理 API 或日志中回显
ALERT_WEBHOOK_URL=
ALERT_BUDGET_THRESHOLD=0.85
ALERT_COOLDOWN_SECONDS=300
