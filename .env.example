# 服务器配置
HOST=0.0.0.0
PORT=8765

# 日志配置
LOG_LEVEL=info
# json 或者 text
LOG_FORMAT=text
# 是否开启详细日志
LOG_DETAILED=false

# 日志文件配置
LOG_FILE=./logs/app.log
LOG_ROTATION=daily
LOG_MAX_FILES=30

ADMIN_AUTH_TOKEN=admin123
CONFIG_FILE=./runtime_models.json
REQUEST_TIMEOUT_MS=300000
REQUEST_STREAM_IDLE_TIMEOUT_MS=120000
