# 服务器配置
HOST=0.0.0.0
PORT=8765

# 日志配置
LOG_LEVEL=info
# json 或者 text
LOG_FORMAT=text
# 是否开启详细日志
LOG_DETAILED=false

# 日志文件配置
LOG_FILE=./logs/app.log
LOG_ROTATION=daily
LOG_MAX_FILES=30

ADMIN_AUTH_TOKEN=admin123
CONFIG_FILE=./runtime_models.json
REQUEST_TIMEOUT_MS=300000
REQUEST_STREAM_IDLE_TIMEOUT_MS=120000

# 重试配置（429 限流响应时的指数退避重试）
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# 连接池配置（上游请求的连接池参数）
MAX_SOCKETS=100
KEEP_ALIVE_TIMEOUT=60000

# 限流配置（保护服务不被过多请求压垮）
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# 集群配置（多进程模式，0=自动检测 CPU 核心数）
CLUSTER_WORKERS=0
