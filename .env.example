# 服务器配置
HOST=0.0.0.0
PORT=8765

# 日志配置
LOG_LEVEL=info
# json 或者 text
LOG_FORMAT=text
# 是否开启详细日志
LOG_DETAILED=false

# 日志文件配置
LOG_FILE=./logs/app.log
LOG_ROTATION=daily
LOG_MAX_FILES=30

# 生产首次运行会自动生成随机口令；手动配置时请改成足够长的随机值。
ADMIN_AUTH_TOKEN=change-me-random-admin-token
CONFIG_FILE=./runtime_models.json
REQUEST_TIMEOUT_MS=300000
REQUEST_STREAM_IDLE_TIMEOUT_MS=120000

# 重试配置（429 限流响应时的指数退避重试）
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# API Key 错误自动禁用（累计错误达到 KEY_MAX_ERRORS 次后自动禁用，true=启用，false=禁用此功能）
# 部分供应商不稳定时可设为 false，或在 config.json 的 provider 中设置 auto_disable_on_error: false
KEY_AUTO_DISABLE=true
KEY_MAX_ERRORS=5

# 连接池配置（上游请求的连接池参数）
MAX_SOCKETS=100
KEEP_ALIVE_TIMEOUT=60000

# 限流配置（保护服务不被过多请求压垮）
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# 本地 JSON 状态只支持单 Worker；多 Worker 需先接入集中式状态存储。
CLUSTER_WORKERS=1
