# 服务器配置
HOST=0.0.0.0
PORT=8765

# 日志配置
LOG_LEVEL=info
# json 或者 text
LOG_FORMAT=text
# 是否允许显式安全诊断事件；不会记录请求/响应正文或凭证
LOG_DETAILED=false

# 可选 Webhook 告警（地址不会在管理 API 或日志中回显）
ALERT_WEBHOOK_URL=
ALERT_BUDGET_THRESHOLD=0.85
ALERT_COOLDOWN_SECONDS=300

# 日志文件配置
LOG_FILE=./logs/app.log
LOG_ROTATION=daily
LOG_MAX_FILES=30

# 生产首次运行会自动生成随机口令；手动配置时请改成足够长的随机值。
ADMIN_AUTH_TOKEN=change-me-random-admin-token
CONFIG_FILE=./runtime_models.json
# 默认 JSON 兼容 Node.js 20；SQLite 与多 Worker 要求 Node.js 22.5+
STORAGE_BACKEND=json
SQLITE_FILE=./runtime.db
REQUEST_TIMEOUT_MS=300000
REQUEST_STREAM_IDLE_TIMEOUT_MS=120000

# 重试配置（429 限流响应时的指数退避重试）
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# API Key 错误自动禁用（累计错误达到 KEY_MAX_ERRORS 次后自动禁用，true=启用，false=禁用此功能）
# 部分供应商不稳定时可设为 false，或在 config.json 的 provider 中设置 auto_disable_on_error: false
KEY_AUTO_DISABLE=true
KEY_MAX_ERRORS=5

# 连接池配置（上游请求的连接池参数）
MAX_SOCKETS=100
KEEP_ALIVE_TIMEOUT=60000

# 限流配置（保护服务不被过多请求压垮）
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# JSON 只支持单 Worker；SQLite 可配置多个 Worker。
CLUSTER_WORKERS=1
